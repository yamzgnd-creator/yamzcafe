# ---------------------------------------------------------------------------
# Deploy target for push-to-vps.sh
#
# Copy this file to .deploy.env and fill in your real values:
#     cp .deploy.env.example .deploy.env
#
# .deploy.env is gitignored and is NEVER uploaded to the server.
# ---------------------------------------------------------------------------

# Your Hostinger VPS IP address (or a domain pointing at it)
VPS_HOST=123.45.67.89

# SSH user (Hostinger VPS default is root)
VPS_USER=root

# Absolute path to the app folder on the VPS.
# This must be the folder that contains server.cjs and your .env
VPS_PATH=/var/www/yamz-cafe/frontend_v54

# SSH port (leave at 22 unless you changed it)
VPS_PORT=22

# PM2 process name (must match what's already running on the VPS)
APP_NAME=yamz-cafe